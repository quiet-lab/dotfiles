# Обновление пакета AUR herdr-bin при загрузке системы, до экрана входа
# (спецификация hyprland-autostart, требование «Обновление herdr при
# загрузке»; выбор пакета AUR вместо herdr update — design.md изменения
# OpenSpec herdr-prestart). Сценарий /usr/local/sbin/herdr-update сравнивает
# версию в AUR с установленной и при новой собирает и ставит пакет.
#
# Ожидание идёт порядком systemd (After=), без опроса. Чтобы долгое
# скачивание не держало вход, у задания этого юнита есть предел
# JobTimeoutSec: по нему systemd снимает только это задание, сборка
# продолжается, greetd стартует (зависимость Wants, не Requires).
[Unit]
Description=Обновление herdr из AUR перед входом в сессию
Wants=network-online.target
# Запросы к AUR идут через туннель amn0 (сценарий привязывает их к amn0):
# юнит ждёт подъёма туннеля, но не поднимает его сам — только порядок,
# без Wants.
After=network-online.target awg-quick@amn0.service
Before=greetd.service
# Срок задания отсчитывается с начала загрузки. До подъёма amn0 вход и так
# ждёт до 105 с (tunnels-before-login.service). Без новой версии юнит
# занимает доли секунды (запрос RPC). С новой версией — 44 с по замеру:
# запрос RPC и сборка 43 с, из них почти всё — скачивание 30 МБ релиза
# с GitHub; втрое — 132 с. 105 + 132 = 237 с, округлено до 240 с.
# Обновление, которое не уложилось, доделывается уже после входа.
JobTimeoutSec=240
JobTimeoutAction=none

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/herdr-update
# Предел всей работы: запрос RPC 15 с, сборка 130 с, установка пакета —
# секунды; 180 с с запасом. По сроку systemd завершает сценарий, каталог
# сборки удаляется, установленный пакет не меняется.
TimeoutStartSec=180

[Install]
WantedBy=greetd.service
