#!/usr/bin/env bash
# Обновление пакета AUR herdr-bin при загрузке системы, до экрана входа
# (спецификация hyprland-autostart, требование «Обновление herdr при
# загрузке»; юнит herdr-update.service, установка — install.sh рядом).
# Ставится в /usr/local/sbin/herdr-update и запускается от root.
#
# Версия в AUR (RPC v5) сравнивается с установленной (pacman -Q). Если в AUR
# новее, снимок PKGBUILD скачивается и собирается makepkg от пользователя
# сборки во временном каталоге /var/cache/herdr-update, затем пакет ставится
# pacman -U. Без сети или при ошибке сценарий пишет причину в журнал
# и завершается; систему он не трогает. Таймеров и опроса нет: сценарий
# запускается один раз за загрузку.
set -euo pipefail

pkg=herdr-bin
user=${HERDR_UPDATE_USER:-mne}
cache=/var/cache/herdr-update
rpc="https://aur.archlinux.org/rpc/v5/info/$pkg"
snapshot="https://aur.archlinux.org/cgit/aur.git/snapshot/$pkg.tar.gz"
# Адреса AUR входят в набор zones туннеля amn0 (подсети США), и соединение,
# помеченное в туннель, обрывается на рукопожатии TLS: ответ сервера крупнее
# MTU туннеля, а размер сегмента TCP выбран по проводному интерфейсу
# (docs/open-questions/amn0-tcp-mss.md). Запросы к AUR привязаны к amn0
# (--interface): тогда размер сегмента выбирается по MTU туннеля.
# Сроки curl: ответ RPC и снимок PKGBUILD — доли секунды; 15 с — с запасом
# на установку соединения.
curl_opts=(-fsSL --max-time 15 --interface amn0)
# Сборка — в основном скачивание бинарника релиза (около 30 МБ с GitHub на
# 0,5–0,7 МБ/с): от снимка PKGBUILD до готового пакета 43 с по замеру
# на станции; 130 с — втрое.
build_timeout=130

if ! aur_json=$(curl "${curl_opts[@]}" "$rpc"); then
    echo "AUR недоступен ($rpc), обновление пропущено"
    exit 0
fi
# Ответ не в JSON (страница обслуживания, заглушка прокси) — тоже «нет версии».
aur=$(jq -r '.results[0].Version // empty' <<<"$aur_json" 2>/dev/null) || aur=
if [ -z "$aur" ]; then
    echo "в ответе AUR нет версии $pkg: ${aur_json:0:200}" >&2
    exit 1
fi
if ! installed=$(pacman -Q "$pkg" 2>/dev/null | awk '{ print $2 }') || [ -z "$installed" ]; then
    echo "пакет $pkg не установлен, обновление не выполняется" >&2
    exit 1
fi
if [ "$(vercmp "$aur" "$installed")" -le 0 ]; then
    echo "$pkg $installed — последняя версия (AUR: $aur)"
    exit 0
fi
echo "$pkg: установлена $installed, в AUR $aur — сборка"

home=$(getent passwd "$user" | cut -d: -f6)
install -d -m 0755 "$cache"
# Каталог сборки удаляется при любом выходе, в том числе по сигналу systemd
# на сроке юнита; остатки прерванного запуска удаляются здесь.
rm -rf -- "$cache"/build.*
dir=$(mktemp -d "$cache/build.XXXXXX")
trap 'rm -rf -- "$dir"' EXIT
trap 'exit 143' TERM INT
chown "$user:" "$dir"

# makepkg — от пользователя (от root он не работает), с чистым окружением
# и каталогами сборки внутри временного каталога: настройки PKGDEST и SRCDEST
# пользователя пакет в чужое место не уносят. Вместо ~/.makepkg.conf
# пользователя читается своя добавка (XDG_CONFIG_HOME): curl бросает попытку
# соединения через 15 с (по умолчанию ждёт 300 с) и рвёт скачивание,
# если скорость ниже 10 КБ/с дольше 30 с, — иначе зависшее скачивание ждало
# бы до срока сборки.
install -d -o "$user" -m 0755 "$dir/config/pacman"
cat > "$dir/config/pacman/makepkg.conf" <<'CONF'
for i in "${!DLAGENTS[@]}"; do
    case ${DLAGENTS[i]} in
    http::/usr/bin/curl\ * | https::/usr/bin/curl\ *)
        DLAGENTS[i]=${DLAGENTS[i]/ -o %o %u/ --connect-timeout 15 --speed-limit 10240 --speed-time 30 -o %o %u}
        ;;
    esac
done
CONF
# shellcheck disable=SC2016 # переменные раскрывает внутренняя оболочка
runuser -u "$user" -- env -i HOME="$home" USER="$user" PATH=/usr/bin \
    LANG=C.UTF-8 XDG_CONFIG_HOME="$dir/config" \
    PKGDEST="$dir" SRCDEST="$dir" BUILDDIR="$dir/build" \
    timeout "$build_timeout" bash -euo pipefail -c '
        cd "$1"
        curl -fsSL --max-time 15 --interface amn0 -o snapshot.tar.gz "$2"
        tar -xzf snapshot.tar.gz
        cd "$3"
        makepkg --noconfirm --noprogressbar
    ' herdr-update-build "$dir" "$snapshot" "$pkg" || {
    echo "сборка $pkg $aur не удалась" >&2
    exit 1
}

shopt -s nullglob
built=()
for f in "$dir/$pkg-$aur"-*.pkg.tar.*; do
    [[ $f == *.sig ]] || built+=("$f")
done
if [ "${#built[@]}" -ne 1 ]; then
    echo "после сборки не найден пакет $pkg-$aur" >&2
    exit 1
fi
pacman -U --noconfirm --needed "${built[0]}"
echo "$pkg обновлён: $installed → $aur"
