#!/usr/bin/env python3
"""Переносит конфиг AmneziaWG из хранилища приложения AmneziaVPN в awg-quick.

Хранилище приложения (QSettings, файл AmneziaVPN.conf) держит в ключе
serversList массив серверов JSON внутри значения @ByteArray(...); у контейнера
awg в поле last_config лежит ещё одна строка JSON, а её поле config — готовый
текст awg-quick. Из него берутся строки [Interface] и [Peer] без DNS
и без строк, которые задаёт шаблон (Table, MTU, FwMark, ловушки), и
подставляются в шаблон /etc/amnezia/amn0.conf.template. Результат пишется
в /etc/amnezia/amneziawg/amn0.conf (root, 0600), только если он отличается
от нынешнего файла. Ключи и параметры обфускации на экран не выводятся.

Запуск с правами root:
    sudo -A -p '...' /usr/local/sbin/amn-export-config [--source ФАЙЛ] [--output ФАЙЛ]
Код выхода: 0 — файл записан или не изменился, 1 — ошибка.
"""

from __future__ import annotations

import argparse
import json
import os
import pwd
import sys
import tempfile
from pathlib import Path

TEMPLATE = Path("/etc/amnezia/amn0.conf.template")
OUTPUT = Path("/etc/amnezia/amneziawg/amn0.conf")
# Страна, выбранная через amn-country (amn-apply-config).
STATE = Path("/etc/amnezia/country.json")
# Ключи [Interface], которые задаёт шаблон: значения приложения отбрасываются.
OWN_INTERFACE_KEYS = {"dns", "table", "mtu", "fwmark", "saveconfig"}
# Ключи, которые переносятся из приложения. Любой другой ключ (в том числе
# ловушки PreUp/PostUp/PreDown/PostDown, которые awg-quick исполняет от root)
# останавливает сборку: хранилище доступно пользователю на запись.
INTERFACE_KEYS = {
    "address",
    "privatekey",
    "listenport",
    "jc",
    "jmin",
    "jmax",
    "s1",
    "s2",
    "s3",
    "s4",
    "h1",
    "h2",
    "h3",
    "h4",
    "i1",
    "i2",
    "i3",
    "i4",
    "i5",
    # Параметры AmneziaWG 2.0 (amneziawg-tools 3.x), которые шлюз Amnezia
    # отдаёт в конфигах стран: защита заголовков, сроки смены ключей,
    # добавка к размеру содержимого.
    "headerprotectionkey",
    "rekeyaftertime",
    "rekeytimeout",
    "rejectaftertime",
    "keepalivetimeout",
    "maxhandshakeattempts",
    "contentpaddingaddition",
}
PEER_KEYS = {
    "publickey",
    "presharedkey",
    "allowedips",
    "endpoint",
    "persistentkeepalive",
}
HEX = "0123456789abcdefABCDEF"
SIMPLE_ESCAPES = {
    "a": "\a",
    "b": "\b",
    "f": "\f",
    "n": "\n",
    "r": "\r",
    "t": "\t",
    "v": "\v",
    '"': '"',
    "'": "'",
    "?": "?",
    "\\": "\\",
}


def qt_unescape(text: str) -> bytes:
    """Раскрывает экранирование значения INI, как его пишет QSettings.

    QSettings записывает байты больше 0x7E и управляющие символы как \\x
    с шестнадцатеричными цифрами переменной длины; цифры читаются, пока
    идут подряд (так их читает и сам Qt).
    """
    out = bytearray()
    i = 0
    while i < len(text):
        ch = text[i]
        if ch != "\\":
            out += ch.encode("latin-1")
            i += 1
            continue
        if i + 1 >= len(text):
            raise SystemExit("serversList: обратная косая черта в конце значения")
        nxt = text[i + 1]
        if nxt in SIMPLE_ESCAPES:
            out += SIMPLE_ESCAPES[nxt].encode("latin-1")
            i += 2
        elif nxt == "x":
            j = i + 2
            while j < len(text) and text[j] in HEX:
                j += 1
            out.append(int(text[i + 2 : j], 16) & 0xFF)
            i = j
        elif nxt in "01234567":
            j = i + 1
            while j < len(text) and j < i + 4 and text[j] in "01234567":
                j += 1
            out.append(int(text[i + 1 : j], 8) & 0xFF)
            i = j
        else:
            out += nxt.encode("latin-1")
            i += 2
    return bytes(out)


def read_servers_list(source: Path) -> tuple[list, str | None]:
    """Возвращает массив серверов и значение defaultServerId."""
    raw = source.read_bytes().decode("latin-1")
    section = None
    servers_raw = None
    default_id = None
    # Только \n: splitlines() режет и по \x85, \x1c–\x1e, которые
    # встречаются внутри байтов UTF-8, прочитанных как latin-1.
    for line in raw.split("\n"):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1]
            continue
        if section != "Servers" or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key == "serversList":
            servers_raw = value
        elif key == "defaultServerId":
            default_id = value.strip()
    if servers_raw is None:
        raise SystemExit("в хранилище нет ключа [Servers] serversList")
    prefix, suffix = '"@ByteArray(', ')"'
    if not (servers_raw.startswith(prefix) and servers_raw.endswith(suffix)):
        raise SystemExit('serversList записан не в виде "@ByteArray(...)"')
    payload = qt_unescape(servers_raw[len(prefix) : -len(suffix)])
    return json.loads(payload.decode("utf-8")), default_id


def awg_config_text(servers: list, default_id: str | None) -> str:
    """Текст awg-quick сервера по умолчанию."""
    index = int(default_id) if default_id and default_id.isdigit() else 0
    if not 0 <= index < len(servers):
        raise SystemExit(f"сервера с номером {index} нет, серверов {len(servers)}")
    for container in servers[index].get("containers", []):
        awg = container.get("awg")
        if not isinstance(awg, dict) or "last_config" not in awg:
            continue
        last = json.loads(awg["last_config"])
        text = last.get("config")
        if isinstance(text, str) and "[Interface]" in text:
            return text
    raise SystemExit(f"у сервера {index} нет контейнера awg с last_config.config")


def split_sections(text: str) -> tuple[list[str], list[str]]:
    """Строки [Interface] без ключей шаблона и строки [Peer].

    Комментарии отрезаются так же, как их отрезает awg-quick (всё после #),
    чтобы заголовки и ключи здесь читались одинаково с ним.
    """
    interface: list[str] = []
    peer: list[str] = []
    current: list[str] | None = None
    seen: set[str] = set()
    for line in text.split("\n"):
        stripped = line.split("#", 1)[0].strip()
        if not stripped:
            continue
        if stripped.startswith("["):
            header = stripped.lower()
            if header not in ("[interface]", "[peer]"):
                raise SystemExit(f"неизвестная секция {stripped} в тексте awg-quick")
            if header in seen:
                raise SystemExit(f"секция {stripped} повторяется в тексте awg-quick")
            seen.add(header)
            current = interface if header == "[interface]" else peer
            continue
        if current is None:
            raise SystemExit("строка вне секций в тексте awg-quick")
        if "=" not in stripped:
            raise SystemExit("строка без «=» в тексте awg-quick")
        key, value = (part.strip() for part in stripped.split("=", 1))
        lkey = key.lower()
        if current is interface:
            if lkey in OWN_INTERFACE_KEYS:
                continue
            allowed = INTERFACE_KEYS
        else:
            allowed = PEER_KEYS
        if lkey not in allowed:
            raise SystemExit(f"ключ {key} не разрешён в тексте awg-quick")
        current.append(f"{key} = {value}")
    if seen != {"[interface]", "[peer]"}:
        raise SystemExit("в тексте awg-quick нужны секции [Interface] и [Peer]")
    for required, lines in (
        ("privatekey", interface),
        ("address", interface),
        ("publickey", peer),
        ("endpoint", peer),
    ):
        if not any(x.split("=", 1)[0].strip().lower() == required for x in lines):
            raise SystemExit(f"в тексте awg-quick нет ключа {required}")
    return interface, peer


def render(template: str, interface: list[str], peer: list[str]) -> str:
    """Подставляет строки в шаблон за один проход по строкам шаблона."""
    out: list[str] = []
    counts = {"@INTERFACE@": 0, "@PEER@": 0}
    for line in template.split("\n"):
        marker = line.strip()
        if marker in counts:
            counts[marker] += 1
            out.extend(interface if marker == "@INTERFACE@" else peer)
        else:
            out.append(line)
    if counts != {"@INTERFACE@": 1, "@PEER@": 1}:
        raise SystemExit("в шаблоне должно быть по одной строке @INTERFACE@ и @PEER@")
    return "\n".join(out)


def default_source() -> Path:
    user = os.environ.get("SUDO_USER")
    home = Path(pwd.getpwnam(user).pw_dir) if user else Path.home()
    return home / ".config/AmneziaVPN.ORG/AmneziaVPN.conf"


def write_if_changed(path: Path, content: str) -> bool:
    if path.exists() and path.read_text() == content:
        return False
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".amn0.")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise
    return True


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--source",
        type=Path,
        default=None,
        help="файл AmneziaVPN.conf (по умолчанию — у пользователя SUDO_USER)",
    )
    parser.add_argument("--template", type=Path, default=TEMPLATE)
    parser.add_argument("--output", type=Path, default=OUTPUT)
    args = parser.parse_args()
    source = args.source or default_source()

    servers, default_id = read_servers_list(source)
    interface, peer = split_sections(awg_config_text(servers, default_id))
    content = render(args.template.read_text(), interface, peer)
    if args.output == OUTPUT:
        # Конфиг снова взят из приложения: страна, выбранная через
        # amn-country, больше не действует.
        STATE.unlink(missing_ok=True)
    if write_if_changed(args.output, content):
        print(
            f"{args.output} записан: строк [Interface] {len(interface)},"
            f" строк [Peer] {len(peer)}"
        )
        print("чтобы туннель взял новый конфиг: systemctl restart awg-quick@amn0")
    else:
        print(f"{args.output} не изменился")
    return 0


if __name__ == "__main__":
    sys.exit(main())
