#!/usr/bin/env bash
# Загружает таблицу nftables inet amn (amn.nft) с наборами zones и bypass.
#
# Набор zones — подсети стран из countries.txt (зоны ipdeny.com, кэш
# по странам в zones.d/ и собранный из него zones.nft) и адреса доменов из
# domains.txt; набор bypass — сервер туннеля из amn0.conf и записи bypass.txt.
# Таблица целиком пересоздаётся одной транзакцией nft -f, поэтому на время
# загрузки правил без наборов нет.
#
#   amn-zones-update --if-stale  скачать зоны, если кэша нет или он старше
#                                7 суток (из amn-route up), загрузить
#   amn-zones-update --force     скачать зоны заново и загрузить
#   amn-zones-update --reload    загрузить из кэша без скачивания (после
#                                правки domains.txt или bypass.txt)
#   amn-zones-update --count     напечатать число элементов набора zones
#
# Ошибки списков не мешают туннелю: зона, которая не скачалась, берётся из
# прежнего кэша страны; имя, которое не разрешилось, и строка, которая
# не является адресом или подсетью IPv4, пропускаются с сообщением.
# Отказ самой загрузки nft -f останавливает подъём туннеля (amn-route up
# снимает правило и завершается ошибкой): без таблицы туннель бесполезен.
set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/bin
export PATH

# AMN_DIR — только для проверки сценария вне /etc.
dir=${AMN_DIR:-/etc/amnezia}
nft_file=$dir/amn.nft
zones_cache=$dir/zones.nft
zones_dir=$dir/zones.d
countries=$dir/countries.txt
domains=$dir/domains.txt
bypass=$dir/bypass.txt
awg_conf=$dir/amneziawg/amn0.conf
max_age_days=7
base_url=https://www.ipdeny.com/ipblocks/data/aggregated

mode=${1:---if-stale}
case "$mode" in
--if-stale | --force | --reload) ;;
--count) ;;
*)
    echo "amn-zones-update: неизвестный ключ $mode" >&2
    exit 2
    ;;
esac

count_zones() {
    nft -j list set inet amn zones | jq '[.nftables[] | select(.set) | .set.elem // [] | length] | add'
}
if [ "$mode" = --count ]; then
    count_zones
    exit
fi

started=$(date +%s%N)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Строки файла без комментариев и пустых строк.
entries() {
    [ -r "$1" ] || return 0
    sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$1"
}

# Адрес или подсеть IPv4 с проверкой октетов 0–255 и длины префикса 0–32;
# всё остальное отбрасывается, чтобы опечатка не сорвала nft -f.
valid_ipv4() {
    awk -v who="$1" '
        {
            ok = split($0, p, "/") <= 2 && split(p[1], o, ".") == 4
            for (i = 1; ok && i <= 4; i++) ok = o[i] ~ /^[0-9]{1,3}$/ && o[i] <= 255
            if (ok && (2 in p)) ok = p[2] ~ /^[0-9]{1,2}$/ && p[2] <= 32
            if (ok) print; else printf "amn-zones-update: %s: пропущена строка %s\n", who, $0 > "/dev/stderr"
        }'
}

# Элементы набора строками nft «add element» по 2000 штук: так парсеру
# не приходится разбирать одну строку на сотню тысяч адресов.
emit_elements() {
    local set=$1
    awk -v set="$set" '
        { buf = buf (n ? ", " : "") $0; n++ }
        n == 2000 { print "add element inet amn " set " { " buf " }"; buf = ""; n = 0 }
        END { if (n) print "add element inet amn " set " { " buf " }" }'
}

download_zones() {
    local cc ok=0 failed=0
    install -d -m 0755 "$zones_dir"
    # Зоны качаются по четыре одновременно: на три десятка параллельных
    # запросов ipdeny.com отвечает 503. Срок соединения и скачивания
    # ограничен, чтобы недоступный сайт не задерживал подъём туннеля без
    # конца. Файл страны заменяется, только если curl завершился успешно:
    # оборванное скачивание оставляет прежний кэш страны.
    # shellcheck disable=SC2016 # переменные раскрывает sh -c, а не эта оболочка
    entries "$countries" | xargs -r -P 4 -I '{}' sh -c \
        'curl -fsS --connect-timeout 10 --max-time 60 -o "$1/$2.part" "$3/$2-aggregated.zone" &&
            mv "$1/$2.part" "$1/$2.zone"' sh "$work" '{}' "$base_url" || true
    for cc in $(entries "$countries"); do
        if [ -s "$work/$cc.zone" ]; then
            install -m 0644 "$work/$cc.zone" "$zones_dir/$cc.zone"
            ok=$((ok + 1))
        else
            failed=$((failed + 1))
            echo "amn-zones-update: зона $cc не скачалась, остаётся прежний кэш страны" >&2
        fi
    done
    echo "amn-zones-update: зон скачано: $ok, отказов: $failed"
    [ "$ok" -gt 0 ]
}

# Собирает zones.nft из кэша стран, перечисленных в countries.txt.
build_zones_cache() {
    local cc
    : >"$work/zones.txt"
    for cc in $(entries "$countries"); do
        [ -r "$zones_dir/$cc.zone" ] && cat "$zones_dir/$cc.zone" >>"$work/zones.txt"
    done
    valid_ipv4 "зоны" <"$work/zones.txt" 2>/dev/null | sort -u >"$work/zones.sorted"
    emit_elements zones <"$work/zones.sorted" >"$work/zones.nft"
    install -m 0644 "$work/zones.nft" "$zones_cache"
    echo "amn-zones-update: подсетей в кэше стран: $(wc -l <"$work/zones.sorted")"
}

need_download=0
case "$mode" in
--force) need_download=1 ;;
--if-stale)
    if [ ! -s "$zones_cache" ] || [ -n "$(find "$zones_cache" -mtime +$((max_age_days - 1)) -print)" ]; then
        need_download=1
    fi
    ;;
esac
if [ "$need_download" -eq 1 ]; then
    # Если не скачалась ни одна зона, кэш не пересобирается: его возраст
    # остаётся прежним, и следующий подъём попробует снова.
    if download_zones; then
        build_zones_cache
    fi
fi

# Адреса доменов: getent идёт через NSS и systemd-resolved, как приложения.
: >"$work/domains.txt"
for name in $(entries "$domains"); do
    if ! getent ahostsv4 "$name" | awk '{ print $1 }' >>"$work/domains.txt"; then
        echo "amn-zones-update: имя $name не разрешилось" >&2
    fi
done

# Сервер туннеля: адрес или имя из Endpoint (порт отбрасывается).
: >"$work/bypass.txt"
entries "$bypass" >>"$work/bypass.txt"
if [ -r "$awg_conf" ]; then
    endpoint=$(sed -n 's/^[[:space:]]*Endpoint[[:space:]]*=[[:space:]]*//p' "$awg_conf" | head -1)
    host=${endpoint%:*}
    if [[ $host =~ ^[0-9.]+$ ]]; then
        echo "$host" >>"$work/bypass.txt"
    elif [ -n "$host" ]; then
        getent ahostsv4 "$host" | awk '{ print $1 }' >>"$work/bypass.txt" || true
    fi
fi

{
    # Объявить и сразу удалить: так транзакция не зависит от того, есть ли
    # таблица, и заменяет её целиком.
    echo "table inet amn"
    echo "delete table inet amn"
    echo "include \"$nft_file\""
    [ -s "$zones_cache" ] && echo "include \"$zones_cache\""
    valid_ipv4 domains.txt <"$work/domains.txt" | sort -u | emit_elements zones
    valid_ipv4 bypass.txt <"$work/bypass.txt" | sort -u | emit_elements bypass
} >"$work/load.nft"

nft -f "$work/load.nft"

elapsed_ms=$((($(date +%s%N) - started) / 1000000))
zones_count=$(count_zones || echo "?")
echo "amn-zones-update: таблица inet amn загружена, элементов zones $zones_count, $elapsed_ms мс"
