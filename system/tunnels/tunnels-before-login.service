# Порядок «туннели до сессии» (изменение OpenSpec tunnel-tray-autostart,
# design D6): экран входа greetd и автовход ждут, пока поднимутся
# awg-quick@amn0 и axata-vpn, — значит, herdr и браузеры, которые открывает
# демон workspaced в сессии, стартуют уже с туннелями.
#
# Ожидание идёт порядком systemd (After=), без опроса. Чтобы зависший
# туннель не держал вход бесконечно, у задания этого юнита есть предел
# JobTimeoutSec: по нему systemd снимает только это задание, туннели
# продолжают подниматься, greetd стартует (зависимость Wants, не Requires),
# а значок туннеля в трее показывает его состояние.
[Unit]
Description=Ожидание туннелей amn0 и axata перед входом в сессию
# Только порядок, без Wants: туннель, выключенный из автозапуска (например,
# install.sh revert для amn0), этим юнитом не поднимается.
After=awg-quick@amn0.service axata-vpn.service
Before=greetd.service
# Срок задания отсчитывается с начала загрузки, а не с момента подъёма
# туннелей, поэтому в него входит и ожидание сети: до 60 с у
# NetworkManager-wait-online (NM_ONLINE_TIMEOUT). Затем туннели поднимаются
# одновременно, дольше — amn0: 14 с по замеру, из них 12 с — загрузка
# списков стран, которая на медленной сети растёт; втрое — 42 с.
# 60 + 42 = 102 с, округлено до 105 с (изменение OpenSpec tunnel-tray-fixes).
JobTimeoutSec=105
JobTimeoutAction=none

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true

[Install]
WantedBy=greetd.service
