#!/usr/bin/env bash
# Выключает остальной звук системы на время диктовки VoxType и возвращает его
# после. Сам VoxType умеет только ставить на паузу MPRIS-плееры (ключ
# pause_media в ~/.config/voxtype/config.toml); звук, который идёт мимо MPRIS —
# уведомления, игры, вкладка браузера без объявленного плеера, — остаётся
# слышен и попадает в микрофон. Этот наблюдатель выключает выход целиком
# (@DEFAULT_AUDIO_SINK@), пока демон сообщает о записи или распознавании.
#
# Наблюдатель ждёт событий, а не опрашивает состояние: `voxtype status --follow`
# печатает по строке на каждое изменение и читает файл состояния
# ($XDG_RUNTIME_DIR/voxtype/state) через inotify. Таймеров и пауз в скрипте нет
# (решение docs/decisions/0007-no-timers.md).
#
# Возврат ровно прежнего состояния: если пользователь выключил звук сам ещё
# до начала записи, после распознавания звук включён не будет. Признак того,
# что выход выключили мы, — файл-метка в $XDG_RUNTIME_DIR. Метка лежит
# в файле, а не только в переменной, чтобы её пережил аварийный конец процесса:
# новый экземпляр, поднятый systemd после падения, видит метку и возвращает
# звук вместо прежнего экземпляра.
set -euo pipefail

sink=@DEFAULT_AUDIO_SINK@
flag="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/voxtype-mute-others.muted"

# Выход выключен прямо сейчас? Строка `wpctl get-volume` при выключенном звуке
# выглядит как «Volume: 1.00 [MUTED]».
sink_muted() {
    local line
    line=$(wpctl get-volume "$sink" 2>/dev/null) || return 1
    [[ $line == *"[MUTED]"* ]]
}

mute_others() {
    if [[ -e $flag ]]; then
        return 0
    fi
    # Звук уже выключен пользователем: не трогаем его и не берём на себя
    # обязанность включить обратно.
    if sink_muted; then
        return 0
    fi
    if wpctl set-mute "$sink" 1; then
        : > "$flag"
    fi
    return 0
}

unmute_others() {
    if [[ ! -e $flag ]]; then
        return 0
    fi
    rm -f "$flag"
    wpctl set-mute "$sink" 0 || true
    return 0
}

# Завершение наблюдателя — остановка юнита, выход демона VoxType, сигнал —
# не должно оставлять систему без звука. Юнит задаёт KillMode=mixed, иначе
# SIGTERM приходит и оболочке, и `voxtype status --follow` одновременно,
# и оболочка, ждущая строку, не всегда успевает выполнить обработчик.
trap 'unmute_others; exit 0' INT TERM
trap 'unmute_others' EXIT

# Метка от прежнего экземпляра, которого не стало без возврата звука
# (SIGKILL, нехватка памяти): доводим начатое до конца.
unmute_others

# Подстановка процесса, а не конвейер: тело цикла должно выполняться в этой же
# оболочке, иначе обработчик сигнала работал бы с другим экземпляром оболочки.
#
# `voxtype status --follow` печатает текущее состояние сразу при запуске
# и дальше по строке на каждое изменение; перезапуск демона VoxType он
# переживает (проверено: idle → stopped → idle).
while IFS= read -r state; do
    case "$state" in
        idle | stopped) unmute_others ;;
        # Пустую строку пропускаем: состоянием она не является.
        '') ;;
        # recording, transcribing, streaming и любое другое состояние — идёт
        # диктовка, остальной звук лишний.
        *) mute_others ;;
    esac
done < <(voxtype status --follow)
