#!/usr/bin/env python3
# Копия шрифта без кодов эмодзи U+1F000…U+1FAFF в таблице cmap и с новым именем семейства.
import sys
from fontTools.ttLib import TTFont
src, dst, family = sys.argv[1], sys.argv[2], sys.argv[3]
f = TTFont(src)
removed = 0
for t in f["cmap"].tables:
    if not hasattr(t, "cmap"):
        continue
    for cp in [c for c in t.cmap if 0x1F000 <= c <= 0x1FAFF]:
        del t.cmap[cp]
        removed += 1
name = f["name"]
style = name.getDebugName(2) or "Regular"
for rec in name.names:
    if rec.nameID in (1, 16):
        rec.string = family
    elif rec.nameID == 4:
        rec.string = family + " " + style
    elif rec.nameID == 6:
        rec.string = (family + "-" + style).replace(" ", "")
f.save(dst)
print(dst, "removed", removed)
