{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Agent"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "~"
    ]
  },
  "model": "fable",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-handoff.sh\" start",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/mne/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/session-handoff.sh\" end",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-decision-notify.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "browser-use@claude-plugins-official": true
  },
  "language": "Русский",
  "sandbox": {
    "enabled": false
  },
  "feedbackDrafts": "off",
  "modelSettings": {
    "claude-fable-5-1": {
      "autoCompactWindow": 400000
    },
    "claude-opus-4-8": {
      "autoCompactWindow": 400000
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true
}
