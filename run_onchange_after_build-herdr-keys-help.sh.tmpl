#!/usr/bin/env bash
# Сборка и регистрация плагина herdr keys-help (изменение OpenSpec herdr-keys-help,
# D1, D12): plugin link сборку не запускает, поэтому её делает этот сценарий после
# применения файлов. Сценарий выполняется заново только при изменении исходников:
# хеши файлов ниже входят в его текст.
{{- $root := joinPath .chezmoi.sourceDir "dot_config/herdr/plugins/keys-help" }}
# Cargo.toml {{ include (joinPath $root "Cargo.toml") | sha256sum }}
# Cargo.lock {{ include (joinPath $root "Cargo.lock") | sha256sum }}
# herdr-plugin.toml {{ include (joinPath $root "herdr-plugin.toml") | sha256sum }}
{{- range (glob (joinPath $root "src/*.rs")) }}
# {{ base . }} {{ include . | sha256sum }}
{{- end }}
{{- range (glob (joinPath $root "src/*/*.rs")) }}
# {{ base . }} {{ include . | sha256sum }}
{{- end }}
set -euo pipefail
cd "$HOME/.config/herdr/plugins/keys-help"
cargo build --release --locked
if command -v herdr >/dev/null 2>&1; then
  herdr plugin link "$PWD" >/dev/null
fi
