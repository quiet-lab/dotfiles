;; ==============================
;;  EWW DASHBOARD — вертикальная колонка плиток у левого края
;;  и окно контекстного меню сети (netmenu).
;;  Сетка: ширина 320px, зазор 10px, хардкод под 3840×2160.
;;
;;  Точка сборки: каждый виджет живёт в widgets/<имя>/ (разметка,
;;  стили и скрипты рядом) и подключается ниже. Здесь — только
;;  окна плиток (tile-*); окно netmenu объявлено в widgets/network/.
;; ==============================

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  Модули виджетов
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(include "./widgets/clock/clock.yuck")
(include "./widgets/weather/weather.yuck")
(include "./widgets/gauges/gauges.yuck")
(include "./widgets/volume/volume.yuck")
(include "./widgets/network/network.yuck")
(include "./widgets/disks/disks.yuck")
(include "./widgets/favorites/favorites.yuck")
(include "./widgets/workspaces/workspaces.yuck")
(include "./widgets/launcher/launcher.yuck")
(include "./widgets/tray/tray.yuck")
(include "./widgets/lang/lang.yuck")
(include "./widgets/hover/hover.yuck")
(include "./widgets/power/power.yuck")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  Окна плиток
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Каждая плитка — отдельное окно eww. Так нужно композитору: picom размывает
;; фон по форме окна целиком, и только при раздельных окнах промежутки между
;; плитками остаются без размытия. Координаты вычислены из высот плиток при
;; зазоре 10px по всей высоте экрана (10..2150px). Раскладка колонки:
;; - вверху — ряд плиток питания (y=10), часы с календарём (76) и погода (325..540);
;; - внизу — лаунчер 320×320 (y=1830), над ним блок рабочих столов с треем и
;;   раскладкой (1462..1820);
;; - оставшиеся плитки (шкалы, громкость, сеть, диски, избранное: 643px)
;;   стоят строго по центру свободного промежутка 540..1462 (отступы 140/139px).
;; Если высота плитки меняется, координаты окон ниже нужно пересчитать.
;;
;; Полный ряд 320px при x=10; ряд шкал — три окна по 100px при x=10/120/230.
;; Страту слева (330px) резервирует каждое окно: Openbox выталкивает окно,
;; целиком лежащее в зоне чужой страты, в рабочую область, а окно с
;; собственной стратой оставляет на месте. Итоговая страта одна — 330px.
;; Тип utility, не dock: Openbox лишает dock-окна фокуса клавиатуры,
;; и поле фильтра лаунчера не получает клавиатуру. utility держит окна
;; вне таскбара.
;; Ряд питания: пять квадратов 56×56 с зазором 10px (5·56 + 4·10 = 320) в самом
;; верху колонки, y=10 — на 66px выше часов.

(defwindow tile-pwr-lock
  :geometry (geometry :x "10px" :y "10px" :width "56px" :anchor "left top")
  :monitor 0
  :reserve (struts :distance "330px" :side "left")
  :windowtype "utility"
  :stacking "fg"
  :wm-ignore false
  (pwr-lock))

(defwindow tile-pwr-logout
  :geometry (geometry :x "76px" :y "10px" :width "56px" :anchor "left top")
  :monitor 0
  :reserve (struts :distance "330px" :side "left")
  :windowtype "utility"
  :stacking "fg"
  :wm-ignore false
  (pwr-logout))

(defwindow tile-pwr-restart
  :geometry (geometry :x "142px" :y "10px" :width "56px" :anchor "left top")
