;; Рабочие столы: по окну на стол, плитка 274×36px, шаг 46px. Число окон равно
;; числу столов в rc.xml Openbox (<desktops><number>8</number>). Справа от них,
;; в полосе 36px (x=294), стоят трей (сверху, во всю высоту блока столов минус
;; плитка раскладки) и переключатель раскладки (внизу, на уровне последнего стола).

(defwindow tile-ws1
  :geometry (geometry :x "10px" :y "1462px" :width "274px" :anchor "left top")
  :monitor 0
  :reserve (struts :distance "330px" :side "left")
  :windowtype "utility"
  :stacking "fg"
  :wm-ignore false
  (workspace-tile :i 0))

