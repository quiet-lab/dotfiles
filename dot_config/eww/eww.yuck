;; ==============================
;;  EWW DASHBOARD — вертикальная колонка плиток у левого края
;;  и окно контекстного меню сети (netmenu).
;;  Сетка: ширина 320px, зазор 5px, хардкод под 3840×2160.
;;
;;  Точка сборки: каждый виджет живёт в widgets/<имя>/ (разметка,
;;  стили и скрипты рядом) и подключается ниже. Здесь — только
;;  композиция колонки и окно dashboard; окно netmenu объявлено
;;  в widgets/network/.
;; ==============================

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  Модули виджетов
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(include "./widgets/clock/clock.yuck")
(include "./widgets/weather/weather.yuck")
(include "./widgets/gauges/gauges.yuck")
(include "./widgets/volume/volume.yuck")
(include "./widgets/network/network.yuck")
(include "./widgets/disks/disks.yuck")
(include "./widgets/favorites/favorites.yuck")
(include "./widgets/workspaces/workspaces.yuck")
(include "./widgets/launcher/launcher.yuck")
(include "./widgets/power/power.yuck")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;  Дашборд
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Колонка плиток: полный ряд 320px, три в ряд — 103px+5px+103px+5px+103px.
(defwidget dash []
  (box :class "dash"
    :orientation "v"
    :space-evenly false
    :spacing 5
  (clock-tile)
  (weather-tile)
  (box :orientation "h" :space-evenly false :spacing 5
   (cpu-tile)
   (ram-tile)
   (gpu-tile))
  (volume-tile)
  (network-tile)
  (disks-tile)
  (favorites-tile)
  (workspaces)
  (launcher-tile)
  (power-tile)))

(defwindow dashboard
  :geometry (geometry :x "5px"
       :y "0px"
       :width "320px"
       :anchor "left center")
  :monitor 0
  :reserve (struts :distance "330px" :side "left")
  ;; Не dock: такие окна Openbox лишает фокуса, и поле фильтра лаунчера
  ;; не получает клавиатуру. utility держит окно вне таскбара.
  :windowtype "utility"
  :stacking "fg"
  :wm-ignore false
(dash))
