#!/bin/sh
# Обновление лаунчера по тексту поля фильтра: запоминает запрос в переменной
# apps-query и перегенерирует сетку в launcher-grid.
# Вызывается из onchange виджета input; '{}' eww подставляет как один аргумент.

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

q=${1:-}

APPS=$DIR/apps-list
[ -x "$APPS" ] || APPS=$DIR/executable_apps-list

eww update apps-query="$(printf '%s' "$q")"
eww update launcher-grid="$("$APPS" "$q")"
