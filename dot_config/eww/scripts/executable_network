#!/bin/sh
# Сеть: активные eth/wifi/vpn с IPv4 → yuck-фрагмент плитки.
row() {
	printf '(box :orientation "h" :class "net-row" :space-evenly false\n (label :class "net-icon %s" :text "%s")\n (label :class "net-text" :text "%s" :hexpand true :xalign 0))' "$2" "$1" "$3"
}
ip_of() { nmcli -t -f IP4.ADDRESS dev show "$1" 2>/dev/null | head -n1 | cut -d: -f2; }

status=$(nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null)

out='(box :orientation "v" :space-evenly false '

eth=$(printf '%s' "$status" | awk -F: '$2=="ethernet" && $3=="connected" {print $1; exit}')
if [ -n "$eth" ]; then
	out="$out$(row 󰈀 net-on "ETH $(ip_of "$eth")")"
else
	out="$out$(row 󰈀 net-off 'ETH отключено')"
fi

wdev=$(printf '%s' "$status" | awk -F: '$2=="wifi" && $1 !~ /^p2p/ {print $1; exit}')
wst=$(printf '%s' "$status" | awk -F: '$2=="wifi" && $1 !~ /^p2p/ {print $3; exit}')
if [ "$wst" = "connected" ]; then
	out="$out$(row 󰤨 net-on "WIFI $(ip_of "$wdev")")"
else
	out="$out$(row 󰤮 net-off 'WIFI отключено')"
fi

vpn=$(nmcli -t -f NAME,TYPE con show --active 2>/dev/null | awk -F: '$2=="vpn" {print $1; exit}')
if [ -n "$vpn" ]; then
	out="$out$(row 󰦝 net-on "VPN $vpn")"
else
	out="$out$(row 󰦝 net-off 'VPN отключено')"
fi

out="$out)"
echo "$out"
