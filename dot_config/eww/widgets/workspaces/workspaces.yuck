;; Рабочие столы Openbox: одинаковые плитки, иконки окон слева, номер стола справа.
;; Каждый стол — отдельное окно eww (tile-ws1…tile-ws8 в eww.yuck), чтобы picom
;; размывал фон только под плитками, а не под промежутками между ними.
;; Состояние приходит JSON-строкой от скрипта (см. заголовок скрипта), разметка описана здесь.

;; --- Реактивный поток состояния ---
(deflisten workspace :initial "{\"desktops\":[]}" "widgets/workspaces/scripts/workspace")

;; --- Виджет ---
;; Плитка стола с индексом i (0-based). Стол выбирается из общего списка
;; фильтром jq, поэтому при отсутствии стола с таким индексом плитка просто
;; не рисуется, без ошибок индексации.
(defwidget workspace-tile [i]
  (box :class "works" :orientation "v" :space-evenly false
    (for d in {jq(workspace.desktops, "map(select(.idx == ${i}))")}
      ;; Плитка стола: клик по свободному месту переключает стол.
      ;; Отступы заданы внутреннему box (ws-body): GTK не учитывает padding у eventbox при размещении.
      (eventbox :class "ws ${d.active ? 'ws-fo' : ''}" :onclick "xdotool set_desktop ${d.idx}"
        (box :class "ws-body" :orientation "h" :space-evenly false
          ;; Ряд иконок: каждая иконка — кнопка перехода к своему окну
          (box :class "ws-icons" :orientation "h" :space-evenly false :hexpand true :halign "start"
            (for w in {d.windows}
              (button :class "ws-win ${w.min ? 'ws-min' : ''}"
                      :tooltip {w.name}
                      :onclick "xdotool set_desktop ${d.idx}; xdotool windowactivate ${w.id}"
                (box :orientation "h" :space-evenly false
                  (image :visible {w.icon != ""} :path {w.icon} :image-width 20 :image-height 20)
                  (label :visible {w.icon == ""} :class "ws-glyph" :text {w.glyph}))))
            ;; Окна сверх лимита
            (label :visible {d.more > 0} :class "ws-more" :text "+${d.more}"))
          ;; Номер стола у правого края
          (label :class "ws-num" :text {d.n} :halign "end"))))))
