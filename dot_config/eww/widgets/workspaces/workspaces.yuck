;; Рабочие столы Openbox: одинаковые плитки, иконки окон слева, номер стола справа.
;; Каждый стол — отдельное окно eww (tile-ws1…tile-ws8 в eww.yuck), чтобы picom
;; размывал фон только под плитками, а не под промежутками между ними.
;; Состояние приходит JSON-строкой от демона eww-daemon (~/work/pets/eww-daemon,
;; символическая ссылка ~/.local/bin/eww-daemon): один процесс с подпиской на события X,
;; задержка обновления единицы миллисекунд. Прежний shell-скрипт
;; widgets/workspaces/scripts/workspace оставлен как запасной вариант.
;; Разметка описана здесь.

;; --- Реактивный поток состояния ---
(deflisten workspace :initial "{\"desktops\":[]}" "~/.local/bin/eww-daemon workspaces")

;; --- Виджет ---
;; Плитка стола с индексом i (0-based). Стол выбирается из общего списка
;; фильтром jq, поэтому при отсутствии стола с таким индексом плитка просто
;; не рисуется, без ошибок индексации.
(defwidget workspace-tile [i]
  (box :class "works" :orientation "v" :space-evenly false
    (for d in {jq(workspace.desktops, "map(select(.idx == ${i}))")}
      ;; Плитка стола: клик по свободному месту переключает стол.
      ;; Отступы заданы внутреннему box (ws-body): GTK не учитывает padding у eventbox при размещении.
      (eventbox :class "ws ${d.active ? 'ws-fo' : ''}" :onclick "xdotool set_desktop ${d.idx}"
        (box :class "ws-body" :orientation "h" :space-evenly false
          ;; Ряд иконок: каждая иконка — кнопка перехода к своему окну (демон
          ;; активирует окно через EWMH: стол окна + _NET_ACTIVE_WINDOW); правый
          ;; клик открывает контекстное меню окна (окно winmenu ниже).
          ;; Без :halign — ряд тянется до блока номера и несёт фон плитки.
          (box :class "ws-icons" :orientation "h" :space-evenly false :hexpand true
            (for w in {d.windows}
              ;; onhover/onhoverlost есть только у eventbox, поэтому кнопка обёрнута в него
              (eventbox :onhover "~/.local/bin/eww-daemon hover window ${w.id}"
                        :onhoverlost "~/.local/bin/eww-daemon hover-hide"
                (button :class "ws-win ${w.min ? 'ws-min' : ''}"
                        :onclick "~/.local/bin/eww-daemon window ${w.id} activate"
                        :onrightclick "~/.local/bin/eww-daemon window-menu ${w.id} ${d.idx}"
                  (box :orientation "h" :space-evenly false
                    (image :visible {w.icon != ""} :path {w.icon} :image-width 20 :image-height 20)
                    (label :visible {w.icon == ""} :class "ws-glyph" :text {w.glyph})))))
            ;; Окна сверх лимита
            (label :visible {d.more > 0} :class "ws-more" :text "+${d.more}"))
          ;; Номер стола у правого края
          (label :class "ws-num" :text {d.n} :halign "end"))))))

;; --- Контекстное меню окна ---
;; Содержимое строит демон (eww-daemon window-menu <id> <стол>): Показать, Свернуть,
;; Закрыть и «На стол N» для всех столов, кроме текущего стола окна. Демон же
;; открывает окно у курсора (eww open winmenu --pos). Меню закрывается после
;; действия и когда курсор его покидает.
(defvar winmenu-content "(box)")

(defwindow winmenu
  :geometry (geometry :x "0px" :y "0px" :anchor "left top")
  :monitor 0
  :stacking "overlay"
  :wm-ignore true
  (eventbox :onhoverlost "eww close winmenu"
    (literal :content winmenu-content)))
