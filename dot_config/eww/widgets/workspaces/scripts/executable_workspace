#!/bin/sh
# Рабочие столы Openbox → JSON-состояние для виджета workspaces (deflisten `workspace`).
# Разметку рисует workspaces.yuck; скрипт только собирает данные.
#
# Формат вывода (одна строка на событие):
#   {"desktops":[{"n":1,"idx":0,"active":false,
#                 "windows":[{"id":29360131,"icon":"/путь.svg","glyph":"","min":false,"name":"Firefox"}],
#                 "more":0}, ...]}
#   n — номер стола для подписи, idx — индекс для xdotool, more — число окон сверх лимита.
#
# Иконки разрешает scripts/appicon (корни ~/.local/share/icons → /usr/share/icons →
# /usr/share/pixmaps, рекурсивно, предпочтение SVG); фолбэк — Nerd Font глиф.
# Обновление: xprop -root -spy _NET_CURRENT_DESKTOP _NET_CLIENT_LIST _NET_CLIENT_LIST_STACKING
# _NET_ACTIVE_WINDOW; два последних покрывают сворачивание и поднятие окон.
# Одинаковые состояния не выводятся повторно.

# Общий резолвер appicon лежит в корневом scripts/: своя папка → корень конфигурации.
APPICON="$(dirname "$0")/appicon"
[ -x "$APPICON" ] || APPICON="$(dirname "$0")/executable_appicon"
[ -x "$APPICON" ] || APPICON="$(dirname "$0")/../../../scripts/appicon"
[ -x "$APPICON" ] || APPICON="$(dirname "$0")/../../../scripts/executable_appicon"

# Максимум иконок на плитке; остальные окна считаются в поле more.
LIMIT=10

# Разделитель полей внутренних записей — управляющий символ US (0x1F).
# Из значений все управляющие символы удаляются при экранировании, поэтому в данных он не встречается.
US=$(printf '\037')

# WM_CLASS (второе поле) → кандидаты имён иконок по убыванию приоритета.
class_icon_names() {
	case "$1" in
		firefox|Navigator)				echo 'firefox' ;;
		Chromium|Google-chrome)			echo 'google-chrome chromium' ;;
		Yandex-browser*)				echo 'yandex-browser' ;;
		Wezterm|org.wezfurlong.wezterm)	echo 'wezterm org.wezfurlong.wezterm /home/mne/builds/wezterm/assets/icon/terminal.png' ;;
		XTerm|Urxvt|st|kitty)			echo 'utilities-terminal' ;;
		Neovide|neovide)				echo 'neovide nvim' ;;
		nvim)							echo 'nvim neovide' ;;
		TelegramDesktop)				echo 'telegram org.telegram.desktop' ;;
		pavucontrol|Pavucontrol)		echo 'pavucontrol' ;;
		nm-connection-editor)			echo 'preferences-system-network' ;;
		Thunar)							echo 'thunar system-file-manager' ;;
		PCManFM)						echo 'pcmanfm system-file-manager' ;;
		Code|code-oss)					echo 'code' ;;
		*)								c=$(printf '%s' "$1" | tr 'A-Z' 'a-z'); echo "$c ${c##*.}" ;;
	esac
}

# Фолбэк-глиф, если иконка не найдена.
class_glyph() {
	case "$1" in
		Neovide|nvim)					echo '' ;;
		*)								echo '' ;;
	esac
}

# WM_CLASS → название программы для всплывающей подсказки.
class_name() {
	case "$1" in
		firefox|Navigator)				echo 'Firefox' ;;
		Chromium|Google-chrome)			echo 'Chrome' ;;
		Yandex-browser*)				echo 'Яндекс Браузер' ;;
		Wezterm|org.wezfurlong.wezterm)	echo 'WezTerm' ;;
		XTerm)							echo 'XTerm' ;;
		Urxvt)							echo 'URxvt' ;;
		st)								echo 'st' ;;
		kitty)							echo 'kitty' ;;
		Neovide|neovide)				echo 'Neovide' ;;
		nvim)							echo 'Neovim' ;;
		TelegramDesktop)				echo 'Telegram' ;;
		pavucontrol|Pavucontrol)		echo 'PulseAudio' ;;
		nm-connection-editor)			echo 'Сети' ;;
		Thunar)							echo 'Thunar' ;;
		PCManFM)						echo 'PCManFM' ;;
		yazi)							echo 'Yazi' ;;
		Code|code-oss)					echo 'VS Code' ;;
		*)								echo "${1##*.}" ;;
	esac
}

# Кандидаты имён → путь к файлу иконки через общий резолвер (с кэшем).
find_icon() {
	# shellcheck disable=SC2086
	[ -n "$1" ] && "$APPICON" $1
}

# Экранирование значения для JSON-строки: удалить управляющие символы, `\` → `\\`, `"` → `\"`.
jesc() {
	printf '%s' "$1" | tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Одна запись на окно: стол, свёрнутость, id, глиф, путь к иконке, название.
# Строковые поля уже экранированы для JSON.
collect() {
	clients=$(xprop -root _NET_CLIENT_LIST 2>/dev/null | grep -o '0x[0-9a-fA-F]*')
	for win in $clients; do
		info=$(xprop -id "$win" _NET_WM_DESKTOP WM_CLASS _NET_WM_STATE 2>/dev/null)
		desk=$(printf '%s\n' "$info" | sed -n 's/^_NET_WM_DESKTOP[^=]*= //p')
		cls=$(printf '%s\n' "$info" | sed -n 's/^WM_CLASS[^=]*= "[^"]*", "\([^"]*\)".*/\1/p')
		# Свёрнутость — атом _NET_WM_STATE_HIDDEN в списке _NET_WM_STATE.
		hidden=0
		case "$info" in *_NET_WM_STATE_HIDDEN*) hidden=1 ;; esac
		[ -n "$desk" ] || continue
		[ "$desk" = "4294967295" ] && continue   # sticky: панели, трей, сами окна eww
		inames=$(class_icon_names "$cls")
		ipath=$(find_icon "$inames")
		glyph=''
		[ -n "$ipath" ] || glyph=$(class_glyph "$cls")
		printf '%s%s%s%s%s%s%s%s%s%s%s\n' \
			"$desk" "$US" "$hidden" "$US" "$((win))" "$US" \
			"$(jesc "$glyph")" "$US" "$(jesc "$ipath")" "$US" "$(jesc "$(class_name "$cls")")"
	done
}

# Сборка JSON по всем столам.
render() {
	current=$(xdotool get_desktop 2>/dev/null || echo 0)
	count=$(xdotool get_num_desktops 2>/dev/null || echo 8)
	records=$(collect)

	out='{"desktops":['
	i=0
	while [ "$i" -lt "$count" ]; do
		wins=''
		n=0
		more=0
		while IFS="$US" read -r d hid wid glyph ipath name; do
			[ "$d" = "$i" ] || continue
			n=$((n + 1))
			if [ "$n" -gt "$LIMIT" ]; then
				more=$((more + 1))
				continue
			fi
			min=false
			[ "$hid" = "1" ] && min=true
			wins="$wins{\"id\":$wid,\"icon\":\"$ipath\",\"glyph\":\"$glyph\",\"min\":$min,\"name\":\"$name\"},"
		done <<EOR
$records
EOR
		active=false
		[ "$i" -eq "$current" ] && active=true
		out="$out{\"n\":$((i + 1)),\"idx\":$i,\"active\":$active,\"windows\":[${wins%,}],\"more\":$more},"
		i=$((i + 1))
	done
	printf '%s\n' "${out%,}]}"
}

# Начальное состояние, затем перерисовка по событиям; одинаковые состояния подавляются.
# _NET_ACTIVE_WINDOW нужен для свёрнутости: Openbox не всегда меняет порядок окон при
# сворачивании, но при сворачивании активного окна фокус переходит, и событие приходит.
prev=$(render)
printf '%s\n' "$prev"
xprop -root -spy _NET_CURRENT_DESKTOP _NET_CLIENT_LIST _NET_CLIENT_LIST_STACKING _NET_ACTIVE_WINDOW 2>/dev/null | while read -r _; do
	new=$(render)
	if [ "$new" != "$prev" ]; then
		printf '%s\n' "$new"
		prev=$new
	fi
done
