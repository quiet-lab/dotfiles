;; Громкость: иконка-микшер и ползунок default sink.
(defpoll current-volume :interval "1s" :initial "0" "widgets/volume/scripts/volume")

(defwidget volume-tile []
 (box :class "tile volume-tile"
   :orientation "h"
   :space-evenly false
   :spacing 8
 (button  :onclick "scripts/popup audio"
    :class "volume-icon"
    :tooltip "Микшер"
 "󰕾")
 (scale  :class "volbar"
    :hexpand true
    :value current-volume
    :orientation "h"
    :tooltip "Громкость: ${current-volume}%"
    :max 101
    :min 0
    :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%")))
