;; Часы, дата и календарь — верхняя плитка колонки.

;; --- Опросы ---
(defpoll hour  :interval "1s" :initial "--" "date '+%H'")
(defpoll min   :interval "1s" :initial "--" "date '+%M'")
(defpoll dash-date :interval "1h" :initial "…" "LC_ALL=ru_RU.UTF-8 date '+%a, %d %b'")

;; --- Календарь ---
;; Сетку строит демон (eww-daemon calendar): шапка с месяцем и годом, названия
;; дней недели и шесть строк дней. Встроенный GtkCalendar не подходит: его шапку
;; нельзя выровнять по сетке, а дни он рисует одним шрифтом, так что сегодняшний
;; день нельзя сделать крупнее. Опрос раз в час подхватывает смену суток;
;; стрелки (calendar shift ±1/±12) и клики по дням (calendar select <дата>)
;; демон обрабатывает сам и сразу обновляет cal-grid. Состояние (смещение
;; месяца, выбранный день) хранится в $XDG_RUNTIME_DIR/eww-daemon/calendar.json.
(defpoll cal-grid :interval "1h" :initial "(box)" "~/.local/bin/eww-daemon calendar")

;; --- Виджет ---
(defwidget clock-tile []
  (box :class "tile clock-tile" :orientation "v" :space-evenly false
    ;; Строка времени и даты выровнена по сетке календаря (класс clock-head в scss).
    (box :class "clock-head" :orientation "h" :space-evenly false
      (label :class "time-hour" :text hour)
      (label :class "time-sep" :text ":")
      (label :class "time-min" :text min)
      (box :hexpand true)
      (label :class "date-label" :text dash-date :halign "end"))
    (literal :content cal-grid)))
