#!/bin/sh
# Текущая раскладка клавиатуры для плитки lang-tile (deflisten `kb-layout`).
# Сначала выводится текущая раскладка, затем — каждое изменение из xkb-switch -W.
# Значение приводится к верхнему регистру: us → US, ru → RU.
# tr вызывается на каждую строку отдельно: иначе его вывод в канал буферизуется
# и плитка обновлялась бы с задержкой.
upper() { printf '%s\n' "$1" | tr '[:lower:]' '[:upper:]'; }

upper "$(xkb-switch -p)"
xkb-switch -W | while read -r layout; do
	upper "$layout"
done
