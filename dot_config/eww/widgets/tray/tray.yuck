;; Системный трей: виджет systray eww. Работает по протоколу StatusNotifierItem
;; (D-Bus): eww сам регистрирует StatusNotifierWatcher. Иконки старого протокола
;; XEmbed (nm-applet и т. п.) попадают сюда через мост xembedsniproxy
;; (см. спецификацию eww-tray-lang).
;;
;; Внизу плитки — собственная иконка громкости. Иконка самого pasystray в трее
;; скрыта (атрибут :hide локальной сборки eww), но программа работает: правый клик
;; по нашей иконке открывает его штатное меню (демон вызывает ContextMenu элемента
;; по D-Bus). Наведение выдвигает над иконкой (не закрывая её) панель с
;; вертикальным ползунком громкости во всю остальную высоту трея (revealer
;; slideup — панель «выезжает» снизу вверх); громкость меняется колесом над
;; иконкой, колесом и кликом по полосе. Левый клик по иконке открывает Volume
;; Control (pavucontrol). Панель исчезает, как только курсор покидает трей, в том
;; числе при открытом меню.
(defvar tray-vol false)
;; Громкость default sink (скрипт widgets/tray/scripts/volume, всегда число).
(defpoll current-volume :interval "1s" :initial "0" "widgets/tray/scripts/volume")

(defwidget tray-tile []
  ;; Внешний eventbox ловит уход курсора со всей плитки трея.
  ;; Три слоя overlay: плитка с иконками трея, панель громкости и — поверх неё —
  ;; иконка громкости. Окно слоя панели перекрывает всё под собой (включая свои
  ;; поля), поэтому кнопка должна лежать выше панели, иначе клики до неё не доходят.
  (eventbox :onhoverlost "eww update tray-vol=false"
    (overlay
      ;; Плитка с иконками трея; внизу оставлено место под кнопку громкости.
      ;; :menu-anchor / :menu-gap — атрибуты из локальной сборки eww: "workarea"
      ;; открывает меню внутри рабочей области с зазором :menu-gap от её края.
      (box :class "tile tray-tile"
        :orientation "v"
        :space-evenly false
        (systray :class "tray" :orientation "v" :spacing 6 :icon-size 20 :prepend-new true :valign "start"
                 :menu-anchor "workarea" :menu-gap 10
                 :hide {["PulseAudio system tray"]})
        (box :vexpand true))
      ;; Панель громкости поверх всей плитки (с рамкой и отступами), её низ — у самой
      ;; высокой точки глифа громкости. Revealer лежит в box с нижним полем (класс
      ;; tray-vol-reveal в scss): при slideup GTK прижимает верх панели к верху
      ;; revealer и открывает её сверху вниз, поэтому поле на самой панели во время
      ;; анимации срезалось, и панель выезжала от низа окна поверх иконки. Поле
      ;; задаётся именно box: у revealer нет узла CSS, и его поле GTK применяет
      ;; как сдвиг содержимого вниз.
      (box :class "tray-vol-reveal" :valign "end" :orientation "v" :space-evenly false
        (revealer :reveal tray-vol :transition "slideup" :duration "150ms"
          (box :class "tray-vol-panel" :orientation "v" :space-evenly false
            (scale :class "tray-vol-scale"
              :orientation "v"
              :flipped true
              :vexpand true
              :min 0 :max 101
              :value current-volume
              :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%")
            (label :class "tray-vol-value" :text "${current-volume}"))))
      ;; Иконка громкости: наведение раскрывает панель и запускает слежение за
      ;; курсором (widgets/tray/scripts/vol-watch закрывает панель, когда курсор
      ;; выходит за окно трея, даже если открытое меню захватило указатель и
      ;; onhoverlost не приходит); колесо над иконкой меняет громкость на 5%
      ;; (vol-step); левый клик — Volume Control, правый — штатное меню pasystray
      ;; через демон. Команды отсоединяются через setsid -f: обработчик eww
      ;; ограничен по времени, и запущенный прямо из него процесс не выживает.
      (eventbox :onhover "eww update tray-vol=true && setsid -f widgets/tray/scripts/vol-watch"
                :onscroll "widgets/tray/scripts/vol-step {}"
                :valign "end" :halign "center"
        (button :class "tray-vol-btn" :onclick "setsid -f pavucontrol"
                :onrightclick "setsid -f ~/.local/bin/eww-daemon tray-menu 'PulseAudio system tray'" "󰕾")))))
