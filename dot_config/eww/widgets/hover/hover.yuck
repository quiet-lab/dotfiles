;; Всплывающая подсказка о приложении (лаунчер) или окне (плитки столов).
;; Содержимое строит демон: eww-daemon hover launcher <id> | hover window <xid>
;; из onhover кнопки; он же открывает окно справа от колонки плиток (x = 340px)
;; на уровне курсора. Окно не следует за курсором и не переоткрывается, пока
;; курсор остаётся в его полосе по вертикали (переход между соседними иконками),
;; поэтому не мелькает. onhoverlost вызывает eww-daemon hover-hide.
(defvar hover-content "(box)")

(defwindow hoverinfo
  :geometry (geometry :x "0px" :y "0px" :width "280px" :anchor "left top")
  :monitor 0
  :stacking "overlay"
  :wm-ignore true
  (literal :content hover-content))
