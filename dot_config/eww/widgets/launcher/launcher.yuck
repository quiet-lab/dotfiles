;; Лаунчер приложений: поиск по названию и сетка полноцветных иконок.
;; Сетку отдаёт демон eww-daemon (~/work/pets/eww-daemon): при старте читает все
;; записи .desktop из ~/.local/share/applications и /usr/share/applications,
;; дальше следит за каталогами через inotify — опросов по таймеру нет.
;; Без фильтра: первый ряд — семь самых частых приложений (статистика запусков
;; хранится в ~/.local/share/eww-daemon/usage.json), затем разделы как в jgmenu
;; с заголовками. При вводе фильтра заголовки исчезают, остаётся список по частоте.
;; Поле ввода передаёт запрос демону через сокет (eww-daemon launcher-query),
;; кнопки запускают приложения через демон (eww-daemon launch <id>).
;; Ряды по 7 иконок; видно ровно три ряда (124px = 3×38 + 2×5), остальное — прокруткой.

;; --- Сетка от демона ---
(deflisten launcher-grid :initial "(box)" "~/.local/bin/eww-daemon launcher")

;; --- Виджет ---
(defwidget launcher-tile []
 (box :class "tile launcher-tile"
   :orientation "v"
   :space-evenly false
 (box :class "apps-header"
   :orientation "h"
   :space-evenly false
   :spacing 5
 (label :class "apps-title" :text "APP:")
 (input :class "apps-search"
   :hexpand true
   :tooltip "Фильтр по названию"
   :onchange "~/.local/bin/eww-daemon launcher-query '{}'"))
 (scroll :class "apps-scroll"
   :hscroll false
   :vscroll true
   :height 124
 (literal :content launcher-grid))))
