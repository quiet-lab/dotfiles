# Панель Quickshell сессии Hyprland (спецификация qs-shell, design D13 изменения
# quickshell-panel): одна копия на сессию, перезапуск при аварийном завершении,
# остановка вместе с hyprland-session.target. WAYLAND_DISPLAY и HYPRLAND_INSTANCE_SIGNATURE приходят из
# окружения пользовательского systemd, куда их импортирует Hyprland. Панель
# запускается после демона workspaced, но не зависит от него: без демона плитки
# столов показывают только окна.
[Unit]
Description=Панель Quickshell (конфигурация panel)
PartOf=hyprland-session.target
After=hyprland-session.target workspaced.service

[Service]
ExecStart=/usr/bin/qs -c panel
Restart=on-failure
RestartSec=1

[Install]
WantedBy=hyprland-session.target
