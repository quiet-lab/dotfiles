# Демон workspaced сессии Hyprland (спецификация ws-daemon, design D14 изменения
# workspace-daemon): владелец модели «приложение, workspace, стол, сессия»,
# одна копия на сессию, перезапуск при аварийном завершении, остановка вместе
# с hyprland-session.target. Запущенные им приложения живут в своих сессиях
# процессов и остановку демона переживают. HYPRLAND_INSTANCE_SIGNATURE и
# WAYLAND_DISPLAY приходят из окружения пользовательского systemd.
[Unit]
Description=Демон workspace (workspaced)
PartOf=hyprland-session.target
After=hyprland-session.target

[Service]
ExecStart=%h/.local/bin/workspaced daemon
Restart=on-failure
RestartSec=1
Environment=RUST_LOG=info
# Приложения запускаются демоном, но не должны умирать вместе с ним.
KillMode=process

[Install]
WantedBy=hyprland-session.target
