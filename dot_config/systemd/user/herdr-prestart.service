# Подготовка herdr к запуску в сессии Hyprland (спецификация
# hyprland-autostart, требование «Быстрая предстартовая подготовка herdr»):
# интеграция herdr с Claude Code и чистый старт herdr без восстановления
# прежних workspace. Шаги — сценарий herdr-prestart, сети они не используют.
# Демон workspaced, который открывает herdr, ждёт этот юнит (After= и Wants= в
# workspaced.service); неудача юнита запуск демона не останавливает.
[Unit]
Description=Подготовка herdr к запуску (интеграция, чистый старт)
PartOf=hyprland-session.target
After=hyprland-session.target
Before=workspaced.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/handmade-scripts/herdr-prestart
# Срок: оба шага — меньше секунды; 30 с — с запасом на запуск herdr.
TimeoutStartSec=30

[Install]
WantedBy=hyprland-session.target
