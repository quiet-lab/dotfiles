#!/bin/sh
# Загрузка GPU в % через nvidia-smi; при ошибке утилиты — 0 и класс t-low.
v=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | tr -d ' ')
case "$v" in ''|*[!0-9]*) v=0 ;; esac
if [ "$v" -lt 50 ]; then c=t-low; elif [ "$v" -lt 75 ]; then c=t-mid; elif [ "$v" -lt 90 ]; then c=t-high; else c=t-crit; fi
printf '{"value":%d,"class":"%s"}\n' "$v" "$c"
