#
# ~/.bashrc
#

[[ $- == *i* ]] && source -- ~/.local/share/blesh/ble.sh --attach=none

alias ls='ls --color=auto'
alias grep='grep --color=auto'

if [ -n "$CONTAINER_ID" ]; then
  # Промпт внутри контейнера Distrobox (Фиолетовый с именем контейнера)
  export PS1="\[\e[35m\][box:${CONTAINER_ID:-distrobox}]\[\e[m\] ✨ \u@\h:\w\$ "
else
  # Промпт на хостовой системе (Зеленый стандартный)
  export PS1="\[\e[1;32m\]\u@\h\[\e[m\]:\w\$ "
fi
eval "$(dircolors -b ~/.config/dircolors)"

# Включение Vi-режима в Bash
set -o vi

. "$HOME/.cargo/env"
eval "$(mise activate bash)"
eval "$(tv init bash)"
# tv init вешает bind -x на C-r и C-t, ble.sh берёт их при ble-attach поверх
# ~/.blerc: возвращаем клавишам штатные виджеты ble.sh
# (клавиши tv в ~/.blerc: M-t и C-M-t)
[[ ! ${BLE_VERSION-} ]] || {
  ble-bind -m vi_imap -f 'C-t' transpose-chars
  ble-bind -m vi_imap -f 'C-r' history-isearch-backward
}
# Функции atuin без собственных привязок C-r и стрелки вверх: клавиши в ~/.blerc
eval "$(atuin init bash --disable-ctrl-r --disable-up-arrow)"
eval "$(zoxide init bash)"

function y() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd <"$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd" || builtin true
  command rm -f -- "$tmp"
}
export PULSE_SERVER=unix:/run/user/1000/pulse/native

# OSC 7: сообщить терминалу (herdr, foot, kitty) текущий каталог после каждой
# команды. Хост в URI пустой: herdr отвергает URI с именем хоста. Путь
# кодируется по RFC 3986 встроенными командами bash, без подпроцессов.
if [[ $- == *i* && $TERM != dumb && $TERM != linux ]]; then
  __osc7_cwd() {
    local LC_ALL=C str=$PWD out= i c
    for ((i = 0; i < ${#str}; i++)); do
      c=${str:i:1}
      case $c in
        [a-zA-Z0-9/._~-]) out+=$c ;;
        *) printf -v c '%%%02X' "'$c"; out+=$c ;;
      esac
    done
    printf '\e]7;file://%s\a' "$out"
  }
  PROMPT_COMMAND="__osc7_cwd${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi

[[ ! ${BLE_VERSION-} ]] || ble-attach

